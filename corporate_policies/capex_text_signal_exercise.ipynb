   "source": [
    "table = df_sig[[\"gvkey\", \"signal\", \"signal_label\"]].merge(firm, on=\"gvkey\", how=\"inner\")\n",
    "\n",
    "cols = [\"company\",\"ticker\",\"signal_label\",\"signal\",\n",
    "        \"capx_2024\",\"capx_growth\",\"capx_to_ppe\",\"capx_to_assets\",\n",

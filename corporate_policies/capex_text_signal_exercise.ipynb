   "source": [
    "### Pulling COMPUSTAT fundamentals from WRDS\n",
    "\n",
    "We pull `comp.funda` for our GVKEYs over fiscal years 2022–2024 with the items needed to build investment, valuation, and financial-characteristic variables.\n",
    "\n",
    "> Requires a WRDS account. The first `wrds.Connection()` call prompts for your username/password and offers to create a `.pgpass` file so you don't re-enter them.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7cd319e0",
   "metadata": {
    "id": "7cd319e0"
   },
   "outputs": [],
   "source": [
    "import wrds\n",
    "\n",
    "db = wrds.Connection(wrds_username=\"YOUR_WRDS_USERNAME\")   # <-- Update with your username\n",
    "\n",
    "gvkey_sql = \",\".join(f\"'{g}'\" for g in df_sig[\"gvkey\"].unique())\n",
    "query = f\"\"\"\n",
    "    SELECT gvkey, datadate, fyear, conm, tic,\n",
    "           capx, at, ppent, xrd, aqc, sale, oancf,\n",
    "           dltt, dlc, che, csho, prcc_f, ceq, txditc, pstkl\n",
    "    FROM comp.funda\n",
    "    WHERE gvkey IN ({gvkey_sql})\n",
    "      AND fyear BETWEEN 2022 AND 2024\n",
    "      AND indfmt='INDL' AND datafmt='STD' AND popsrc='D' AND consol='C'\n",
    "\"\"\"\n",
    "funda = db.raw_sql(query)\n",
    "db.close()\n",
    "\n",
    "num = [\"capx\",\"at\",\"ppent\",\"xrd\",\"aqc\",\"sale\",\"oancf\",\n",
    "       \"dltt\",\"dlc\",\"che\",\"csho\",\"prcc_f\",\"ceq\",\"txditc\",\"pstkl\"]\n",
    "funda[\"gvkey\"] = funda[\"gvkey\"].astype(str).str.zfill(6)\n",
    "for c in num:\n",
    "    funda[c] = pd.to_numeric(funda[c], errors=\"coerce\")\n",
    "funda = funda.sort_values([\"gvkey\", \"fyear\"])\n",
    "print(f\"Pulled {len(funda)} firm-year rows.\")\n",
    "funda.head()"
   ]
  },
